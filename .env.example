# URL do backend deployado (Vercel), usada pelo app pra chamar /api/chat.
# Preencha depois do deploy, ex: https://riva-ia.vercel.app
EXPO_PUBLIC_API_BASE_URL=

# Só usada pelo backend (função serverless em api/chat.ts) — NUNCA prefixar
# com EXPO_PUBLIC_, senão vaza pro bundle do app. Configurar direto no painel
# do Vercel (Settings > Environment Variables), não aqui.
# GEMINI_API_KEY=
