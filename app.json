{
  "expo": {
    "name": "riva.ia",
    "slug": "rivaIA-challenge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-riva.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rivaia.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "A RIVA usa suas fotos para anexar imagens de veículos na conversa.",
        "NSMicrophoneUsageDescription": "A RIVA usa o microfone para você conversar por voz."
      }
    },
    "android": {
      "package": "com.rivaia.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-riva.png",
        "backgroundColor": "#201C1D"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/logo-riva.png"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "A RIVA usa suas fotos para anexar imagens de veículos na conversa."
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-riva.png",
          "resizeMode": "contain",
          "backgroundColor": "#201C1D"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c14d29ee-7f02-4560-bbba-6c30848de3fd"
      }
    },
    "owner": "xsmits"
  }
}
